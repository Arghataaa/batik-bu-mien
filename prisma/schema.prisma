// Batik Bu Mien — Prisma schema (SQLite)
// Ready-to-wear batik products: kemeja, daster, sarung, sorban, blangkon, dll.
// Supports flexible categories, optional product variants (size/color/motif),
// atomic stock movements, and snapshot-based sales history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | KASIR
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales          Sale[]
  stockMovements StockMovement[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  contact      String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  stockMovements StockMovement[]
}

model Product {
  id                String           @id @default(cuid())
  name              String
  sku               String           @unique
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  description       String?
  imageUrl          String?
  price             Int              // selling price (Rupiah, snapshot source)
  cost              Int?             // modal per unit (optional)
  active            Boolean          @default(true)
  lowStockThreshold Int              @default(5)
  hasVariants       Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  variants          ProductVariant[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]

  @@index([categoryId])
  @@index([active])
}

model ProductVariant {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String           @unique
  size      String?
  color     String?
  motif     String?
  stock     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  saleItems SaleItem[]
  stockMovements StockMovement[]

  @@index([productId])
}

model StockMovement {
  id         String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type       String   // IN | OUT | ADJUST
  quantity   Int      // signed: positive IN, negative OUT/ADJUST delta
  reason     String?
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  saleId     String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
  @@index([type])
}

model Sale {
  id            String     @id @default(cuid())
  invoiceNo     String     @unique
  total         Int        // grand total (snapshot)
  totalCost     Int        @default(0) // cost of goods (snapshot)
  totalProfit   Int        @default(0) // total - totalCost
  paymentMethod String     @default("CASH") // CASH | QRIS | DEBIT | TRANSFER
  paidAmount    Int        @default(0)
  changeAmount  Int        @default(0)
  userId        String?
  user          User?      @relation(fields: [userId], references: [id])
  customerName  String?
  note          String?
  createdAt     DateTime   @default(now())
  items         SaleItem[]

  @@index([createdAt])
  @@index([paymentMethod])
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerName    String
  customerPhone   String
  customerEmail   String
  province        String
  city            String
  district        String
  village         String
  postalCode      String
  address         String
  note            String?
  subtotal        Int
  shippingCost    Int      @default(0)
  discount        Int      @default(0)
  total           Int
  paymentMethod   String   @default("MIDTRANS")
  paymentStatus   String   @default("PENDING_SHIPPING")
  orderStatus     String   @default("WAITING_SHIPPING_CONFIRMATION")
  paymentOrderId  String?  @unique
  snapToken       String?
  trackingToken   String   @unique @default(cuid())
  courier         String?
  trackingNumber  String?
  adminNote       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]

  @@index([customerPhone])
  @@index([paymentStatus])
  @@index([orderStatus])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  variantId    String
  name         String
  sku          String
  variantLabel String?
  price        Int
  quantity     Int
  subtotal     Int
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model ShippingSetting {
  id              String   @id @default("default")
  storeName       String   @default("Batik Bu Mien")
  phone           String?
  address         String?
  province        String?
  provinceId      String?
  city            String?
  cityId          String?
  district        String?
  districtId      String?
  postalCode      String?
  biteshipAreaId  String?  @map("biteshipAreaId")
  updatedAt       DateTime @updatedAt
}

model SaleItem {
  id           String           @id @default(cuid())
  saleId       String
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product          @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  name         String           // snapshot product name
  sku          String           // snapshot product/variant sku
  variantLabel String?         // snapshot "Size M / Warna Cokelat / Motif Kawung"
  price        Int              // snapshot selling price per unit
  cost         Int              @default(0) // snapshot cost per unit
  quantity     Int
  subtotal     Int              // price * quantity

  @@index([saleId])
  @@index([productId])
}
